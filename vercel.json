{
  "version": 2,
  "builds": [
    {
      "src": "index.py",
      "use": "@vercel/python"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/webhook",
      "dest": "index.py"
    },
    {
      "src": "/api/webhook",
      "dest": "index.py"
    },
    {
      "src": "/alert",
      "dest": "index.py"
    },
    {
      "src": "/api/alert",
      "dest": "index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
